{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UAV Embedded Command Acknowledgement v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "deviceId",
    "commandId",
    "status",
    "reason",
    "cargoLock",
    "deviceMode"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "deviceId": {
      "const": "uav-01"
    },
    "commandId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "status": {
      "enum": [
        "ACK",
        "NACK"
      ]
    },
    "reason": {
      "type": "string"
    },
    "cargoLock": {
      "enum": [
        "LOCKED",
        "UNLOCKED"
      ]
    },
    "deviceMode": {
      "enum": [
        "IDLE",
        "EN_ROUTE",
        "WAITING_FOR_HANDOVER"
      ]
    }
  }
}
