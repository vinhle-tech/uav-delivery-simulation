{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UAV Embedded Command v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "commandId",
    "deviceId",
    "type",
    "value"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "commandId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "deviceId": {
      "type": "string",
      "pattern": "^uav-[0-9]{2}$"
    },
    "type": {
      "const": "SET_CARGO_LOCK"
    },
    "value": {
      "enum": [
        "LOCK",
        "UNLOCK"
      ]
    }
  }
}
